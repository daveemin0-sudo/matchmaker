{
  "appId": "com.hookmebysam.app",
  "appName": "hookmebysam",
  "webDir": ".",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": true,
    "buildOptions": {
      "keystorePath": "hookmebysam.keystore",
      "keystoreAlias": "hookmebysam",
      "releaseType": "AAB"
    }
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#0A0710",
      "androidSplashResourceName": "splash",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": false,
      "style": "DARK",
      "backgroundColor": "#0A0710"
    },
    "NavigationBar": {
      "color": "#00000000",
      "darkButtons": false
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}