# ==========================================================
# hookmebysam — Environment Configuration Template
# Copy this file to .env and fill in your real credentials.
# NEVER commit your real .env file to Git!
# ==========================================================

# Server Port
PORT=3001

# Termii SMS Configuration (Nigerian Phone OTP)
# Sign up at https://app.termii.com
TERMII_API_KEY=your_termii_api_key_here
TERMII_SENDER_ID=N-Alert

# Paystack API Keys (VIP Gold Subscriptions)
# Get keys at https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key_here
PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key_here

# Allowed Frontend Origins (CORS protection)
# In production, specify your exact domain:
ALLOWED_ORIGINS=https://hookmebysam.com,http://localhost:5500,http://127.0.0.1:5500

# Firebase Admin SDK Service Account Credentials
# Download the service account JSON from Firebase Console -> Project Settings -> Service accounts
# Encode the JSON file as Base64:
# In Node.js: Buffer.from(fs.readFileSync('service-account.json')).toString('base64')
FIREBASE_SERVICE_ACCOUNT_BASE64=your_base64_encoded_service_account_json_here
