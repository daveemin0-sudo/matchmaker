# hookmebysam production backend environment
PORT=3001
FRONTEND_URL=https://hookmebysam.com
ALLOWED_ORIGINS=https://hookmebysam.com

# Firebase Admin
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_JSON=
# Or use FIREBASE_SERVICE_ACCOUNT_BASE64 instead.

# Paystack
PAYSTACK_SECRET_KEY=sk_live_replace_me

# Termii
TERMII_API_KEY=replace_me
TERMII_SENDER_ID=N-Alert

# Required secret for scheduled story cleanup
CLEANUP_SECRET=replace_with_a_long_random_secret

# Metered TURN
METERED_API_KEY=replace_me
METERED_DOMAIN=hookmebysam.metered.live

# Swipe abuse / product limit
DAILY_FREE_SWIPES=100
