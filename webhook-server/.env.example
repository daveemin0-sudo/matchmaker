# hookmebysam Webhook Server — Environment Variables
# Copy this file to .env and fill in your actual keys
# NEVER commit .env to Git!

# ---- Firebase ----
# Your Firebase Project ID (from Firebase Console → Project Settings)
FIREBASE_PROJECT_ID=your-firebase-project-id

# ---- Paystack ----
# Your SECRET key from https://dashboard.paystack.com (NOT the public key)
PAYSTACK_SECRET_KEY=sk_live_your_secret_key_here

# ---- Termii (Nigerian SMS OTP) ----
# Get from https://termii.com → Settings → API Keys
TERMII_API_KEY=your_termii_api_key_here

# ---- Server ----
PORT=3001
FRONTEND_URL=https://hookmebysam.com
