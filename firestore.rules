rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function participant(matchData) {
      return signedIn() && matchData != null && ('users' in matchData) && request.auth.uid in matchData.users;
    }

    function safeParticipant(matchData) {
      return participant(matchData);
    }

    // Block docs are written only by the backend, with deterministic ids
    // `${blocker}_${blocked}`, so rules can check both directions. A match id
    // is the two uids sorted and joined by '_'.
    function notBlocked(matchId) {
      return matchId.split('_').size() == 2
        && !exists(/databases/$(database)/documents/blocks/$(matchId.split('_')[0] + '_' + matchId.split('_')[1]))
        && !exists(/databases/$(database)/documents/blocks/$(matchId.split('_')[1] + '_' + matchId.split('_')[0]));
    }

    // Fields only the trusted backend may write: entitlements, roles, verification, moderation
    // state and account lifecycle. A client cannot grant itself VIP or lift its own suspension.
    function serverOnlyUserFields() {
      return ['isVip','vipTier','vipPlan','vipExpiry','vipExpiresAt','vipActivatedAt','role',
        'emailVerified','phoneVerified','subscriptionStatus','paystackReference','paystackEmail','paystackAmount',
        'suspended','suspendedAt','suspensionReason','unsuspendedAt','mergedInto','mergedAt','deletedAt'];
    }

    // ── users ───────────────────────────────────────────────────────────────
    // All signed-in users must be able to read user profiles to discover cards,
    // search users, and view match profiles.
    // Account owners can create and update their profiles, but cannot grant
    // themselves VIP or elevate their role.
    match /users/{userId} {
      // Only the owner reads their private document. (An email-match clause used to let anyone
      // holding an unverified token for the same email read it; no client code relied on it.)
      allow read: if owner(userId);
      // Sign-up writes isVip:false / phoneVerified:false; only those safe values are accepted.
      allow create: if owner(userId)
        && !request.resource.data.keys().hasAny(serverOnlyUserFields().removeAll(['isVip','role','phoneVerified','emailVerified']))
        && (!('isVip' in request.resource.data) || request.resource.data.isVip == false)
        && (!('role' in request.resource.data) || request.resource.data.role == 'user')
        && (!('phoneVerified' in request.resource.data) || request.resource.data.phoneVerified == false)
        && (!('emailVerified' in request.resource.data) || request.resource.data.emailVerified == false);
      allow update: if owner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(serverOnlyUserFields());
      allow delete: if owner(userId);
    }

    // ── public_profiles (fallback collection if used) ───────────────────────
    match /public_profiles/{userId} {
      allow read: if signedIn();
      // Public profiles are published only by the trusted backend/Admin SDK.
      allow create, update, delete: if false;
    }

    // ── voice_intros: audio kept by the backend when Cloud Storage is not provisioned.
    // Served through GET /profiles/{uid}/voice-intro, which enforces blocks.
    match /voice_intros/{userId} {
      allow read, write: if false;
    }

    // ── security_events / security_alerts: written and read only by the backend
    // (GET /admin/security). Clients have no access at all.
    match /security_events/{eventId} {
      allow read, write: if false;
    }
    match /security_alerts/{alertId} {
      allow read, write: if false;
    }

    // ── app_feedback (in-app rating prompt) ────────────────────────────────
    // Create-only, tied to the signed-in user, bounded fields. Nobody can read it from a client.
    match /app_feedback/{feedbackId} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'userName', 'rating', 'feedback', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.feedback is string && request.resource.data.feedback.size() <= 1000
        && request.resource.data.userName is string && request.resource.data.userName.size() <= 80;
      allow read, update, delete: if false;
    }

    // ── presence (Live user online/offline status) ─────────────────────────
    match /presence/{userId} {
      allow read: if signedIn();
      allow write: if owner(userId);
    }

    // ── swipes ──────────────────────────────────────────────────────────────
    // Users create swipes when swiping right / left on discovery cards.
    match /swipes/{swipeId} {
      allow read: if signedIn() && resource.data.fromUserId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // ── matches ─────────────────────────────────────────────────────────────
    // Formed when two users mutually swipe or start a chat.
    match /matches/{matchId} {
      allow read: if signedIn() && (
        participant(resource.data) || (request.auth.uid in matchId.split('_'))
      );
      // The doc id must be exactly the two uids in `users`, so the id-based
      // checks used by messages/storage can never disagree with the users
      // array, and neither side can be blocked.
      allow create: if signedIn()
        && ('users' in request.resource.data)
        && request.auth.uid in request.resource.data.users
        && request.resource.data.users.size() == 2
        && matchId.split('_').size() == 2
        && request.resource.data.users.hasAll(matchId.split('_'))
        && notBlocked(matchId);
      // Participants may update chat metadata but never change WHO the
      // participants are. Compared as a set, not by array order: the backend
      // writes users unsorted while the client writes them sorted.
      allow update: if signedIn() && (
        participant(resource.data) || (request.auth.uid in matchId.split('_'))
      ) && (
        !('users' in request.resource.data.diff(resource.data).affectedKeys())
        || (
          request.resource.data.users.size() == resource.data.users.size()
          && request.resource.data.users.hasAll(resource.data.users)
        )
      );
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn() && (
          (request.auth.uid in matchId.split('_'))
          || (exists(/databases/$(database)/documents/matches/$(matchId)) && participant(get(/databases/$(database)/documents/matches/$(matchId)).data))
        );
        allow create: if signedIn()
          && request.resource.data.sender == request.auth.uid
          && (
            (request.auth.uid in matchId.split('_'))
            || (exists(/databases/$(database)/documents/matches/$(matchId)) && participant(get(/databases/$(database)/documents/matches/$(matchId)).data))
          )
          && notBlocked(matchId)
          && (!('text' in request.resource.data) || request.resource.data.text.size() <= 5000);
        // The sender may edit or soft-delete their own message; either participant may mark it
        // read or react. Nobody can rewrite the other person's words or change who sent it.
        allow update: if signedIn() && (
          (request.auth.uid in matchId.split('_'))
          || (exists(/databases/$(database)/documents/matches/$(matchId)) && participant(get(/databases/$(database)/documents/matches/$(matchId)).data))
        ) && (
          (resource.data.sender == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['text','edited','editedAt','deleted','reactions','read','readAt'])
            && (!('text' in request.resource.data) || request.resource.data.text.size() <= 5000))
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read','readAt','reactions'])
        );
        allow delete: if signedIn()
          && resource.data.sender == request.auth.uid;
      }

      match /meta/{docId} {
        allow read, write: if signedIn() && (
          (request.auth.uid in matchId.split('_'))
          || (exists(/databases/$(database)/documents/matches/$(matchId)) && participant(get(/databases/$(database)/documents/matches/$(matchId)).data))
        );
      }

      match /calls/{callId} {
        allow read: if signedIn() && (
          (request.auth.uid in matchId.split('_'))
          || (exists(/databases/$(database)/documents/matches/$(matchId)) && participant(get(/databases/$(database)/documents/matches/$(matchId)).data))
        );
        allow write: if notBlocked(matchId) && signedIn() && (
          (request.auth.uid in matchId.split('_'))
          || (exists(/databases/$(database)/documents/matches/$(matchId)) && participant(get(/databases/$(database)/documents/matches/$(matchId)).data))
        );
        match /candidates/{candidateId} {
          allow read, write: if signedIn() && (
            (request.auth.uid in matchId.split('_'))
            || (exists(/databases/$(database)/documents/matches/$(matchId)) && participant(get(/databases/$(database)/documents/matches/$(matchId)).data))
          );
        }
      }
    }

    // ── calls (collection-group for incoming call listeners) ─────────────────
    match /{path=**}/calls/{callId} {
      allow read: if signedIn() && resource.data.calleeId == request.auth.uid;
      allow write: if false;
    }
    match /{path=**}/candidates/{candidateId} { allow read, write: if false; }

    // ── stories ─────────────────────────────────────────────────────────────
    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'id','docId','name','image','thumb','video','isVideo','mediaType',
          'storagePath','location','bio','tags','isUserStory','ownerId',
          'createdAt','expiresAt'
        ])
        && request.resource.data.id == storyId
        && request.resource.data.docId == storyId;
      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name','image','thumb','video','isVideo','mediaType','storagePath','location','bio','tags','expiresAt']);
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /story_views/{storyId}/viewers/{viewerId} {
      allow read, write: if owner(viewerId);
    }

    // ── reports ─────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow create, read, update, delete: if false;
    }

    // ── blocks ──────────────────────────────────────────────────────────────
    match /blocks/{blockId} {
      allow read: if signedIn() && resource.data.blockedBy == request.auth.uid;
      allow create, update, delete: if false;
    }

    // ── fcm_tokens ──────────────────────────────────────────────────────────
    match /fcm_tokens/{userId}/tokens/{tokenId} {
      allow read, write: if owner(userId);
    }

    match /otp_requests/{docId} {
      allow read, write: if false;
    }

    match /paystack_transactions/{docId} {
      allow read, write: if false;
    }
  }
}