rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function participant(matchData) {
      return signedIn() && request.auth.uid in matchData.users;
    }

    // ── users ───────────────────────────────────────────────────────────────
    // All signed-in users must be able to read user profiles to discover cards,
    // search users, and view match profiles.
    // Account owners can create and update their profiles, but cannot grant
    // themselves VIP or elevate their role.
    match /users/{userId} {
      allow read: if owner(userId);
      allow create: if owner(userId)
        && (!('isVip' in request.resource.data) || request.resource.data.isVip == false)
        && (!('role' in request.resource.data) || request.resource.data.role == 'user');
      allow update: if owner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['isVip','vipTier','vipPlan','vipExpiry','vipExpiresAt','vipActivatedAt','role','emailVerified','phoneVerified','subscriptionStatus','paystackReference','paystackEmail','paystackAmount']);
      allow delete: if owner(userId);
    }

    // ── public_profiles (fallback collection if used) ───────────────────────
    match /public_profiles/{userId} {
      allow read: if signedIn();
      // Public profiles are published only by the trusted backend/Admin SDK.
      allow create, update, delete: if false;
    }

    // ── swipes ──────────────────────────────────────────────────────────────
    // Users create swipes when swiping right / left on discovery cards.
    match /swipes/{swipeId} {
      allow read: if signedIn() && resource.data.fromUserId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // ── matches ─────────────────────────────────────────────────────────────
    // Formed when two users mutually swipe. Messages, calls, and metadata live here.
    match /matches/{matchId} {
      allow read: if participant(resource.data);
      allow create: if false;
      allow update: if participant(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['lastMessage','lastSender','lastUpdated','lastActivity','status']);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if participant(get(/databases/$(database)/documents/matches/$(matchId)).data);
        allow create: if participant(get(/databases/$(database)/documents/matches/$(matchId)).data)
          && request.resource.data.sender == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'sender','text','isVoice','audioUrl','imageUrl','videoUrl','isVideo',
            'read','timestamp','replyTo','localId','reactions'
          ])
          && (!('text' in request.resource.data) || request.resource.data.text.size() <= 5000);
        allow update: if participant(get(/databases/$(database)/documents/matches/$(matchId)).data)
          && (
            (resource.data.sender == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['text','imageUrl','videoUrl','audioUrl','isVoice','isVideo','replyTo','reactions','editedAt','read']))
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          );
        allow delete: if participant(get(/databases/$(database)/documents/matches/$(matchId)).data)
          && resource.data.sender == request.auth.uid;
      }

      match /meta/{docId} {
        allow read, write: if participant(get(/databases/$(database)/documents/matches/$(matchId)).data);
      }

      match /calls/{callId} {
        allow read, write: if participant(get(/databases/$(database)/documents/matches/$(matchId)).data);
        match /candidates/{candidateId} {
          allow read, write: if participant(get(/databases/$(database)/documents/matches/$(matchId)).data);
        }
      }
    }

    // ── calls (collection-group for incoming call listeners) ─────────────────
    match /{path=**}/calls/{callId} { allow read, write: if false; }
    match /{path=**}/candidates/{candidateId} { allow read, write: if false; }

    // ── stories ─────────────────────────────────────────────────────────────
    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'id','docId','name','image','thumb','video','isVideo','mediaType',
          'storagePath','location','bio','tags','isUserStory','ownerId',
          'createdAt','expiresAt'
        ])
        && request.resource.data.id == storyId
        && request.resource.data.docId == storyId
;      allow update: if signedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name','image','thumb','video','isVideo','mediaType','storagePath','location','bio','tags','expiresAt']);
      allow delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /story_views/{storyId}/viewers/{viewerId} {
      allow read, write: if owner(viewerId);
    }

    // ── reports ─────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if false;
    }

    // ── blocks ──────────────────────────────────────────────────────────────
    match /blocks/{blockId} {
      allow read: if signedIn() && resource.data.blockedBy == request.auth.uid;
      allow create: if signedIn() && request.resource.data.blockedBy == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.blockedBy == request.auth.uid;
    }

    // ── fcm_tokens ──────────────────────────────────────────────────────────
    match /fcm_tokens/{userId}/tokens/{tokenId} {
      allow read, write: if owner(userId);
    }

    match /otp_requests/{docId} {
      allow read, write: if false;
    }

    match /paystack_transactions/{docId} {
      allow read, write: if false;
    }
  }
}