rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }
    function participant(matchData) {
      return signedIn() && request.auth.uid in matchData.users;
    }

    // ── users ───────────────────────────────────────────────────────────────
    // All signed-in users must be able to read user profiles to discover cards,
    // search users, and view match profiles.
    // Account owners can create and update their profiles, but cannot grant
    // themselves VIP or elevate their role.
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if owner(userId)
        && (!('isVip' in request.resource.data) || request.resource.data.isVip == false)
        && (!('role' in request.resource.data) || request.resource.data.role == 'user');
      allow update: if owner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['isVip','vipTier','vipPlan','vipExpiry','vipExpiresAt','vipActivatedAt','role','emailVerified','phoneVerified','subscriptionStatus','paystackReference','paystackEmail','paystackAmount']);
      allow delete: if owner(userId);
    }

    // ── public_profiles (fallback collection if used) ───────────────────────
    match /public_profiles/{userId} {
      allow read: if signedIn();
      allow create, update: if owner(userId);
      allow delete: if owner(userId);
    }

    // ── swipes ──────────────────────────────────────────────────────────────
    // Users create swipes when swiping right / left on discovery cards.
    match /swipes/{swipeId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.fromUserId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.fromUserId == request.auth.uid;
    }

    // ── matches ─────────────────────────────────────────────────────────────
    // Formed when two users mutually swipe.
    match /matches/{matchId} {
      allow read: if signedIn() && (request.auth.uid in resource.data.users);
      allow create: if signedIn() && (request.auth.uid in request.resource.data.users);
      allow update: if signedIn() && (request.auth.uid in resource.data.users);
      allow delete: if signedIn() && (request.auth.uid in resource.data.users);

      match /messages/{messageId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.users;
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.users
          && request.resource.data.sender == request.auth.uid;
        allow update, delete: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.users;
      }

      match /meta/{docId} {
        allow read, write: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.users;
      }

      match /calls/{callId} {
        allow read, write: if signedIn();

        match /candidates/{candidateId} {
          allow read, write: if signedIn();
        }
      }
    }

    // ── calls (collection-group for incoming call listeners) ─────────────────
    match /{path=**}/calls/{callId} {
      allow read, write: if signedIn();
    }

    match /{path=**}/candidates/{candidateId} {
      allow read, write: if signedIn();
    }

    // ── stories ─────────────────────────────────────────────────────────────
    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /story_views/{storyId}/viewers/{viewerId} {
      allow read, write: if signedIn();
    }

    // ── reports ─────────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow create: if signedIn();
      allow read: if signedIn();
    }

    // ── blocks ──────────────────────────────────────────────────────────────
    match /blocks/{blockId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.blockedBy == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.blockedBy == request.auth.uid;
    }

    // ── fcm_tokens ──────────────────────────────────────────────────────────
    match /fcm_tokens/{userId}/tokens/{tokenId} {
      allow read, write: if owner(userId);
    }

    match /otp_requests/{docId} {
      allow read, write: if false;
    }

    match /paystack_transactions/{docId} {
      allow read, write: if false;
    }
  }
}