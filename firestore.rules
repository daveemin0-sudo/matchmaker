rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function participant(matchData) {
      return signedIn() && request.auth.uid in matchData.users;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if owner(userId)
        && (!('isVip' in request.resource.data) || request.resource.data.isVip == false)
        && (!('role' in request.resource.data) || request.resource.data.role == 'user')
        && (!('isVip' in request.resource.data) || request.resource.data.isVip == false)
        && (!('phoneVerified' in request.resource.data) || request.resource.data.phoneVerified == false)
        && (!('emailVerified' in request.resource.data) || request.resource.data.emailVerified == false);
      allow update: if owner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['isVip','vipTier','vipPlan','vipExpiry','vipExpiresAt','vipActivatedAt','role','emailVerified','phoneVerified','subscriptionStatus','paystackReference','paystackEmail','paystackAmount']);
      allow delete: if owner(userId);
    }

    match /swipes/{swipeId} {
      allow create: if signedIn()
        && request.resource.data.fromUserId == request.auth.uid
        && request.resource.data.toUserId is string
        && request.resource.data.action in ['like','pass','superlike'];
      allow read: if signedIn() && resource.data.fromUserId == request.auth.uid;
      allow update, delete: if false;
    }

    match /matches/{matchId} {
      allow read: if participant(resource.data);
      allow create: if false;
      allow update: if participant(resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['users','createdAt']);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if participant(get(/databases/$(database)/documents/matches/$(matchId)).data);
        allow create: if participant(get(/databases/$(database)/documents/matches/$(matchId)).data)
          && request.resource.data.sender == request.auth.uid;
        allow update: if participant(get(/databases/$(database)/documents/matches/$(matchId)).data)
          && resource.data.sender == request.auth.uid;
        allow delete: if participant(get(/databases/$(database)/documents/matches/$(matchId)).data)
          && resource.data.sender == request.auth.uid;
      }

      match /meta/{docId} {
        allow read, write: if participant(get(/databases/$(database)/documents/matches/$(matchId)).data);
      }
    }

    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /story_views/{storyId}/viewers/{viewerId} {
      allow create: if owner(viewerId);
      allow read: if signedIn();
      allow update: if owner(viewerId);
      allow delete: if owner(viewerId);
    }

    match /reports/{reportId} {
      allow create: if signedIn() && request.resource.data.reportedBy == request.auth.uid;
      allow read, update, delete: if false;
    }

    match /fcm_tokens/{userId}/tokens/{tokenId} {
      allow read: if owner(userId);
      allow create, update, delete: if owner(userId);
    }

    match /otp_requests/{docId} {
      allow read, write: if false;
    }

    match /paystack_transactions/{docId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}